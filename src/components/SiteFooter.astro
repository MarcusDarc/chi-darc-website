---
import { localizePath, t, type Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<p class="site-footer__copy">{t(locale, 'footerCopy')}</p>
		<nav class="site-footer__nav" aria-label="Footer">
			<a href={localizePath(locale)}>{t(locale, 'navHome')}</a>
			<a href={localizePath(locale, 'about')}>{t(locale, 'navAbout')}</a>
			<a href={localizePath(locale, 'contact')}>{t(locale, 'navContact')}</a>
		</nav>
	</div>
</footer>
